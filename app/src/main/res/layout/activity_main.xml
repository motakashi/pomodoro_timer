<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/settings_title"
            android:textColor="#212121"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:text="@string/set_count_label"
                android:textColor="#424242"
                android:textSize="20sp" />

            <Button
                android:id="@+id/set_decrease"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:contentDescription="@string/decrease_set_count"
                android:text="−"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/set_count"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="4"
                android:textColor="#212121"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/set_increase"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:contentDescription="@string/increase_set_count"
                android:text="+"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:text="@string/long_break_label"
                android:textColor="#424242"
                android:textSize="20sp" />

            <Button
                android:id="@+id/break_decrease"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:contentDescription="@string/decrease_break"
                android:text="−"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/break_minutes"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="20"
                android:textColor="#212121"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/break_increase"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:contentDescription="@string/increase_break"
                android:text="+"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/reset_button"
                android:layout_width="150dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:text="@string/reset"
                android:textSize="18sp" />

            <Button
                android:id="@+id/start_button"
                android:layout_width="150dp"
                android:layout_height="56dp"
                android:text="@string/start"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/timer_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/set_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#616161"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phase_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#212121"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/timer_card"
            android:elevation="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/time_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="#207249"
                android:textSize="40sp"
                android:textStyle="bold" />

            <motakashi.androidapp.pomodorotimer.MinuteProgressView
                android:id="@+id/time_progress"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pause_button"
                android:layout_width="150dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:text="@string/pause"
                android:textSize="18sp" />

            <Button
                android:id="@+id/resume_button"
                android:layout_width="150dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:text="@string/resume"
                android:textSize="18sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/end_button"
                android:layout_width="150dp"
                android:layout_height="56dp"
                android:text="@string/end"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
